{
	"name": "@jiralite/dtt",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"deploy": "pnpm run build && wrangler deploy",
		"deploy-commands": "node --env-file=.dev.vars source/utility/deploy-commands.ts",
		"dev": "vite dev",
		"format": "oxlint --fix . && oxfmt .",
		"knip": "knip && knip --strict --include unlisted",
		"lint": "oxfmt --check . && oxlint .",
		"lint:ci": "oxfmt --check . && oxlint --format=github .",
		"postinstall": "react-router typegen",
		"preview": "pnpm run build && vite preview",
		"typecheck": "wrangler types --check && react-router typegen && tsc --build",
		"types": "wrangler types",
		"update": "pnpm update --interactive --latest"
	},
	"dependencies": {
		"@icons-pack/react-simple-icons": "^13.15.1",
		"discord-api-types": "^0.38.54",
		"isbot": "^5.2.1",
		"lucide-react": "^1.38.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.0",
		"@discordjs/core": "^2.6.0",
		"@discordjs/rest": "^2.6.3",
		"@react-router/dev": "^8.3.0",
		"@react-router/fs-routes": "^8.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"knip": "^6.32.3",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"oxlint-tsgolint": "^7.0.2001",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"wrangler": "^4.126.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.22.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": ">=26",
			"onFail": "error"
		}
	}
}
